# WeatherGPT Environment Configuration
# Backend Server Settings
PORT=5000

# Optional LLM Proxy Key (Anthropic Claude API Key)
# If provided, backend calls Claude 3 Haiku for conversational AI chat responses.
# If omitted, WeatherGPT automatically activates its built-in Intelligent Fallback AI Weather Engine.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
